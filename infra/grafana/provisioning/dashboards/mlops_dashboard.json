{
  "title": "MLOps - Adobe Image Classifier",
  "uid": "mlops-adobe-001",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total Predictions per Minute",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "targets": [{
        "expr": "rate(predictions_total[1m]) * 60",
        "legendFormat": "{{model_version}} - {{label}}"
      }]
    },
    {
      "id": 2,
      "title": "Prediction Latency (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(prediction_latency_seconds_bucket[5m]))",
        "legendFormat": "p95 latency - {{model_version}}"
      }]
    },
    {
      "id": 3,
      "title": "Data Drift Share",
      "type": "stat",
      "gridPos": { "x": 0, "y": 6, "w": 6, "h": 4 },
      "targets": [{
        "expr": "ml_data_drift_share",
        "legendFormat": "Drift share"
      }],
      "options": {
        "thresholds": {
          "steps": [
            { "value": 0,   "color": "green" },
            { "value": 0.2, "color": "yellow" },
            { "value": 0.3, "color": "red" }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Model Accuracy",
      "type": "stat",
      "gridPos": { "x": 6, "y": 6, "w": 6, "h": 4 },
      "targets": [{
        "expr": "ml_model_accuracy",
        "legendFormat": "Accuracy"
      }],
      "options": {
        "thresholds": {
          "steps": [
            { "value": 0,    "color": "red" },
            { "value": 0.7,  "color": "yellow" },
            { "value": 0.85, "color": "green" }
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Retraining Alerts",
      "type": "stat",
      "gridPos": { "x": 12, "y": 6, "w": 6, "h": 4 },
      "targets": [{
        "expr": "ml_drift_alert",
        "legendFormat": "Retrain triggered"
      }]
    },
    {
      "id": 6,
      "title": "Predictions by Class",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 7 },
      "targets": [{
        "expr": "sum by (label) (predictions_total)",
        "legendFormat": "{{label}}"
      }]
    },
    {
      "id": 7,
      "title": "A/B Traffic Split",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 7 },
      "targets": [{
        "expr": "sum by (model_version) (predictions_total)",
        "legendFormat": "{{model_version}}"
      }]
    }
  ]
}
